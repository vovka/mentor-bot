[Unit]
Description=Mentor bot: Telegram chat agent and background job launcher
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/mentor-bot
EnvironmentFile=%h/dev/mentor-bot/.env
ExecStart=%h/dev/mentor-bot/.venv/bin/mentor serve
Restart=always
# background jobs (`mentor job-run`) live in this cgroup and must outlive a restart
KillMode=process
# the Telegram long-poll returns within ~40 s
TimeoutStopSec=60

[Install]
WantedBy=default.target
